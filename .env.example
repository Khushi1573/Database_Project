# Copy this file to .env and fill in real values. .env is gitignored.
# Never commit real credentials, and never use the MySQL root user for
# auditing or workload tooling.

MYSQL_ROOT_PASSWORD=change_me_root_password

# Read-only metadata/status/metrics account (NFR-9)
AUDIT_DB_USER=audit
AUDIT_DB_PASSWORD=change_me_audit_password

# Benchmark workload account, scoped to the `bench` schema only (NFR-9)
BENCH_DB_USER=bench
BENCH_DB_PASSWORD=change_me_bench_password

# Host port MySQL is published on for localhost-only access (loopback).
MYSQL_HOST_PORT=13306
