# Runner image: Python 3.12 + study dependencies + sysbench, used to drive
# the benchmark workload and run the audit/orchestrator/reporting tooling
# against the per-cell mysql:8.4 containers on the audit-net bridge network.
FROM python:3.12-slim

RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        sysbench \
        default-mysql-client \
        build-essential \
        pkg-config \
        default-libmysqlclient-dev \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

COPY requirements.txt /app/requirements.txt
RUN pip install --no-cache-dir -r requirements.txt

COPY . /app

ENTRYPOINT ["python", "-m", "src.cli"]
CMD ["--help"]
